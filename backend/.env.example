PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=globetrotter

JWT_SECRET=change_me_in_dev
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# External services (optional — services fall back to seeded data if unset)
GEODB_API_KEY=
OPENTRIPMAP_API_KEY=
FLIGHTFARE_API_KEY=

# Email (forgot password) — no fallback, point at a free testing inbox (e.g. Mailtrap) for local dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@globetrotter.local

